{
  "name": "bp-dev",
  "version": "0.15.9-dev.20261113122352",
  "description": "Your AI build partner. Expert guidance, coaching, and personalized training inside Claude Code.",
  "author": {
    "name": "BuildPartner.ai"
  },
  "homepage": "https://buildpartner.ai",
  "repository": "https://github.com/austinmarchese/buildpartner-plugin",
  "license": "MIT",
  "keywords": [
    "coaching",
    "training",
    "productivity",
    "claude-code"
  ],
  "userConfig": {
    "install_code": {
      "type": "string",
      "title": "Install code",
      "description": "Signs this install in to BuildPartner.ai. Filled in by the install command on buildpartner.ai; works once. Leave empty otherwise.",
      "required": false
    }
  },
  "mcpServers": {
    "tools": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/bp-node",
      "args": [
        "--npx",
        "-y",
        "buildpartner@0.15.9-dev.20261113122352",
        "serve"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/bin/bp-node ${CLAUDE_PLUGIN_ROOT}/hooks/install-code.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/bin/bp-node ${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/bin/bp-node ${CLAUDE_PLUGIN_ROOT}/hooks/plugin-update.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/hooks/improve-reminder.sh start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/hooks/improve-reminder.sh ran",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/bin/bp-node ${CLAUDE_PLUGIN_ROOT}/hooks/flush.mjs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/bin/bp-node ${CLAUDE_PLUGIN_ROOT}/hooks/plugin-update.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/hooks/improve-reminder.sh ran",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__plugin_[^_]+_tools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/bin/bp-node ${CLAUDE_PLUGIN_ROOT}/hooks/emit.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__plugin_(buildpartner|bp-dev)_tools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/bin/bp-node ${CLAUDE_PLUGIN_ROOT}/hooks/permission.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "types": "./types/index.d.ts"
}
