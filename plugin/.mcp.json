{
  "mcpServers": {
    "tools": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/bp-node",
      "args": [
        "--npx",
        "-y",
        "buildpartner@0.15.18-dev.20261124131209",
        "serve"
      ],
      "env": {
        "BP_HOSTED_URL": "https://dev.buildpartner.ai/api/mcp"
      }
    },
    "hosted": {
      "type": "http",
      "url": "https://dev.buildpartner.ai/api/mcp",
      "headersHelper": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/bp-auth-header\"",
      "timeout": 300000,
      "headers": {
        "X-BuildPartner-Plugin": "1"
      }
    }
  }
}
